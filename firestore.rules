rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function messDoc(messId) { return /databases/$(database)/documents/messes/$(messId); }
    function memberDoc(messId, uid) { return /databases/$(database)/documents/messes/$(messId)/members/$(uid); }
    function isMessOwner(messId) { return signedIn() && get(messDoc(messId)).data.adminId == request.auth.uid; }
    function hasMe(messId) { return signedIn() && exists(memberDoc(messId, request.auth.uid)); }
    function me(messId) { return get(memberDoc(messId, request.auth.uid)).data; }
    function isActive(messId) { return isMessOwner(messId) || (hasMe(messId) && me(messId).status == 'ACTIVE'); }
    function isManagerOrAdmin(messId) {
      return isMessOwner(messId) || (hasMe(messId) && me(messId).status == 'ACTIVE' && (me(messId).role == 'ADMIN' || me(messId).role == 'MANAGER'));
    }
    function isAdmin(messId) {
      return isMessOwner(messId) || (hasMe(messId) && me(messId).status == 'ACTIVE' && me(messId).role == 'ADMIN');
    }

    // Users: private to the owner only
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Invite codes: lookup by exact code only (no listing); only the mess admin can write
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && isMessOwner(request.resource.data.messId);
      allow update: if signedIn() && isMessOwner(resource.data.messId) && request.resource.data.messId == resource.data.messId;
      allow delete: if signedIn() && isMessOwner(resource.data.messId);
    }

    // Collection-group: a user can query their own memberships across messes
    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || request.auth.uid == memberId);
    }

    match /messes/{messId} {
      allow read: if signedIn() && (resource.data.adminId == request.auth.uid || hasMe(messId));
      allow create: if signedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if signedIn() && (
        isMessOwner(messId) ||
        (isManagerOrAdmin(messId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentMonth', 'isClosed']))
      );
      allow delete: if isMessOwner(messId);

      match /members/{memberId} {
        allow read: if signedIn() && (isActive(messId) || request.auth.uid == memberId);

        allow create: if signedIn() && (
          // self join request
          (request.auth.uid == memberId && request.resource.data.userId == request.auth.uid &&
           request.resource.data.status == 'PENDING' && request.resource.data.role == 'MEMBER' &&
           request.resource.data.type == 'ACCOUNT' && request.resource.data.openingBalance == 0) ||
          // admin's own member doc at mess creation
          (isMessOwner(messId) && request.auth.uid == memberId && request.resource.data.role == 'ADMIN') ||
          // managed member added by admin/manager
          (isManagerOrAdmin(messId) && request.resource.data.type == 'MANAGED' &&
           request.resource.data.createdBy == request.auth.uid && request.resource.data.role == 'MEMBER')
        );

        allow update: if signedIn() && (
          isAdmin(messId) ||
          (isManagerOrAdmin(messId) && resource.data.role != 'ADMIN' && request.resource.data.role != 'ADMIN') ||
          // rejected/removed user re-requests: may ONLY change status/joinDate/leaveDate
          (request.auth.uid == memberId && request.resource.data.userId == request.auth.uid &&
           (resource.data.status == 'REJECTED' || resource.data.status == 'REMOVED') &&
           request.resource.data.status == 'PENDING' &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'joinDate', 'leaveDate']))
        );

        allow delete: if signedIn() && (isAdmin(messId) || (isManagerOrAdmin(messId) && resource.data.role != 'ADMIN'));
      }

      match /meals/{id} {
        allow read: if isActive(messId);
        allow create, update: if isManagerOrAdmin(messId) || (isActive(messId) && request.resource.data.memberId == request.auth.uid);
        allow delete: if isManagerOrAdmin(messId);
      }
      match /expenses/{id} {
        allow read: if isActive(messId);
        allow create, update, delete: if isManagerOrAdmin(messId);
      }
      match /deposits/{id} {
        allow read: if isActive(messId);
        allow create, update, delete: if isManagerOrAdmin(messId);
      }
      match /fixedCosts/{id} {
        allow read: if isActive(messId);
        allow create, update, delete: if isManagerOrAdmin(messId);
      }
      match /closings/{id} {
        allow read: if isActive(messId);
        allow create, update, delete: if isManagerOrAdmin(messId);
      }
    }
  }
}
